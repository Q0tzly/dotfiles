# Loader only. The shared base lives in shell/base.sh, human extras in
# shell/human.sh, so zsh and bash stay in sync.
# Profile: DOTFILES_PROFILE=ai skips decoration and convenience aliases
# for agent sessions. Default is human.
# Installers (Devin, LM Studio, grok, ...) append their own PATH lines to
# this file. Review them with `git diff` and fold them into shell/base.sh.

DOTFILES="${DOTFILES:-$HOME/dev/github.com/q0tzly/dotfiles}"

. "$DOTFILES/shell/base.sh"

if [[ "${DOTFILES_PROFILE:-human}" == "human" ]]; then
  fpath=($DOTFILES/shell/completions $HOME/.grok/completions/zsh(N-/) $fpath)
  autoload -Uz compinit && compinit
  command -v starship >/dev/null && eval "$(starship init zsh)"
  command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
  # Inside a pstty session, suppress zsh's PROMPT_SP "%" end-of-line mark
  # for the whole shell's lifetime. Toggling it per-prompt via precmd/
  # preexec doesn't work: zsh decides whether to print the mark before
  # precmd hooks run, so an unsetopt there is always one step too late.
  [[ -n "$PSTTY_SESSION" ]] && unsetopt PROMPT_SP
  . "$DOTFILES/shell/human.sh"
  alias zz='z ..'
fi

# Machine-specific settings and secrets (not tracked).
[[ -f "$HOME/.zshrc.local" ]] && . "$HOME/.zshrc.local"
